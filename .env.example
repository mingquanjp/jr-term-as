# Backend port used by the Vite /api proxy.
PORT=3001

# Optional override for the local user store.
USERS_FILE=data/users.json

# Optional values used by `pnpm auth:seed-admin`.
ADMIN_EMAIL=admin@jr-term.local
ADMIN_PASSWORD=replace-with-a-strong-password

# Keep false for the original dictionary-only behavior.
QWEN_CONTEXT_GATE=false

# Enable only while the SSH tunnel to the local Qwen/vLLM server is running.
QWEN_BASE_URL=http://127.0.0.1:18000/v1
QWEN_API_KEY=replace-with-your-local-vllm-key
QWEN_MODEL=Qwen/Qwen3-4B-Instruct-2507-FP8

# risky validates Context Required and short variants; all validates every match.
QWEN_CONTEXT_GATE_MODE=risky
QWEN_TIMEOUT_MS=45000
